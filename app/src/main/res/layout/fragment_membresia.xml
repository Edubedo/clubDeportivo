<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.membresia.MembresiaFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/text_membresia_tipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="Paquete Familiar" />

            <TextView
                android:id="@+id/text_membresia_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                tools:text="ACTIVA · $7000 al mes" />

            <TextView
                android:id="@+id/text_membresia_vigencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Vigente del 2026-01-01 al 2026-12-31" />

            <TextView
                android:id="@+id/text_membresia_beneficios_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Qué incluye"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_membresia_beneficios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="• Incluye 2 adultos y 3 niños\n• Acceso a todas las áreas"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_membresia_integrantes_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Integrantes familiares"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_membresia_integrantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="• María Pérez (Cónyuge)\n• Luis Pérez (Hijo)" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress_membresia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
