<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema de la ventana en modo claro (lo que se ve antes de que Compose pinte); el modo oscuro vive en values-night. -->
    <style name="Base.Theme.ClubDeportivo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/soft_blue_selection</item>
        <item name="colorOnPrimaryContainer">@color/deep_navy</item>
        <item name="colorSecondary">@color/slate_accent</item>
        <item name="colorOnSecondary">@color/deep_navy</item>
        <item name="colorTertiary">@color/court_green</item>
        <item name="colorOnTertiary">@color/deep_navy</item>
        <item name="colorError">@color/alert_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/fondo_app</item>
        <item name="colorOnBackground">@color/texto_principal</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/texto_principal</item>
    </style>

    <style name="Theme.ClubDeportivo" parent="Base.Theme.ClubDeportivo" />

    <!-- Pantalla de arranque de marca: fondo azul del club con el balón, en vez de una ventana en blanco. Al terminar, la
         app pasa a Theme.ClubDeportivo. -->
    <style name="Theme.ClubDeportivo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ClubDeportivo</item>
    </style>
</resources>
